# Normalise line endings so the repository is identical on Windows, Linux and
# macOS. Without this, every commit from a Windows checkout reports CRLF
# conversion warnings and diffs can appear whole-file.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary - never convert, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.faiss binary
*.pkl binary
*.ttf binary
*.ttc binary
*.otf binary
*.zip binary
*.dcm binary

# Notebooks: diff as text but do not merge automatically - the JSON structure
# makes conflict resolution by hand unreliable.
*.ipynb text merge=binary

# Keep generated artefacts out of language statistics
knowledge_base/** linguist-documentation
docs/** linguist-documentation
