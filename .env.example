# Axial Screening Assistant - environment overrides
#
# Copy to .env and edit. .env is git-ignored.
# Every value here is optional; sensible defaults are in configs/default.yaml.

# --- Web -------------------------------------------------------------------
# Flask session key. Without it an ephemeral key is generated at start-up and
# sessions do not survive a restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NEUROSCAN_SECRET_KEY=

NEUROSCAN_WEB_PORT=5000
NEUROSCAN_WEB_DEBUG=false

# --- Language model --------------------------------------------------------
# ollama (default, local and offline) | huggingface | echo (no generation)
NEUROSCAN_LLM_PROVIDER=ollama
NEUROSCAN_LLM_MODEL=llama3.1:8b
NEUROSCAN_LLM_BASE_URL=http://localhost:11434

# Only needed for a hosted provider. Never commit a real key.
NEUROSCAN_LLM_API_KEY=

# --- Compute ---------------------------------------------------------------
# auto | cuda | cpu
NEUROSCAN_DEVICE=auto

# --- Data ------------------------------------------------------------------
# Override to keep clinical data off the project drive, e.g. on an encrypted
# volume. See docs/ETHICS.md.
NEUROSCAN_DATA_ROOT=data
